// Create each definition separately as a measure. Fact and dimension query names
// must match the CSV base names. Use one scenario on Pages 1–3.
// Ratios below return BLANK unless exactly one scenario is in context.

Demand Units =
IF(HASONEVALUE(dim_scenario[scenario]), SUM(production_plan[demand_units]))

Completed Aircraft =
IF(HASONEVALUE(dim_scenario[scenario]), SUM(production_plan[produced]))

OTIF % =
IF(HASONEVALUE(dim_scenario[scenario]),
    DIVIDE(SUM(production_plan[on_time_due]), SUM(production_plan[demand_units])))

Ending Backlog =
VAR LastWeek = MAX(dim_week[week])
RETURN IF(HASONEVALUE(dim_scenario[scenario]),
    CALCULATE(SUM(production_plan[backlog]),
        REMOVEFILTERS(dim_week), dim_week[week] = LastWeek))

Backlog Aircraft Weeks =
IF(HASONEVALUE(dim_scenario[scenario]), SUM(production_plan[backlog]))

Factory Utilization % =
// Deliberately blank under family filters: capacity is shared, not family-specific.
IF(HASONEVALUE(dim_scenario[scenario]) && NOT ISCROSSFILTERED(products[product]),
    DIVIDE(SUM(capacity_execution[used_hours]), SUM(capacity_execution[available_hours])))

Family Share of Factory Capacity % =
IF(HASONEVALUE(dim_scenario[scenario]),
    DIVIDE(SUM(production_plan[used_hours]), SUM(capacity_execution[available_hours])))

Plan Adherence % =
IF(HASONEVALUE(dim_scenario[scenario]),
    MAX(0, 1 - DIVIDE(SUM(production_plan[absolute_deviation]),
                     SUM(production_plan[baseline_plan]))))

Reference Output =
IF(HASONEVALUE(dim_scenario[scenario]), SUM(production_plan[baseline_plan]))

Output Deviation = [Completed Aircraft] - [Reference Output]

WAPE % =
IF(HASONEVALUE(dim_scenario[scenario]),
    DIVIDE(SUM(forecast_accuracy[absolute_error]), SUM(forecast_accuracy[demand_units])))

Rolling 4W OTIF % =
VAR EndWeek = MAX(dim_week[week])
RETURN CALCULATE([OTIF %],
    FILTER(ALL(dim_week), dim_week[week] <= EndWeek && dim_week[week] > EndWeek - 4))

Rolling 4W WAPE % =
VAR EndWeek = MAX(dim_week[week])
RETURN CALCULATE([WAPE %],
    FILTER(ALL(dim_week), dim_week[week] <= EndWeek && dim_week[week] > EndWeek - 4))

Closing Component Units =
VAR LastWeek = MAX(dim_week[week])
RETURN IF(HASONEVALUE(dim_scenario[scenario]) && HASONEVALUE(components[component]),
    CALCULATE(SUM(material_balance[closing_units]),
        REMOVEFILTERS(dim_week), dim_week[week] = LastWeek))

Component Coverage Weeks =
VAR LastWeek = MAX(dim_week[week])
RETURN IF(HASONEVALUE(dim_scenario[scenario]) && HASONEVALUE(components[component]),
    CALCULATE(MAX(material_balance[coverage_weeks]),
        REMOVEFILTERS(dim_week), dim_week[week] = LastWeek))

Material Block Events =
IF(HASONEVALUE(dim_scenario[scenario]), SUM(material_balance[blocked_orders]))

Stockout Component Weeks =
IF(HASONEVALUE(dim_scenario[scenario]), SUM(material_balance[stockout]))

FAL Overload Weeks =
IF(HASONEVALUE(dim_scenario[scenario]),
    CALCULATE(COUNTROWS(capacity_execution), capacity_execution[overload_hours] > 0))

Source Release Utilization % =
IF(HASONEVALUE(dim_scenario[scenario]),
    DIVIDE(SUM(supplier_release_load[allocated_units]),
           SUM(supplier_release_load[available_capacity])))

Late or Open Orders =
IF(HASONEVALUE(dim_scenario[scenario]),
    CALCULATE(COUNTROWS(order_fulfillment), order_fulfillment[late_or_open] = 1))

Full Horizon Recovery Cost USD =
IF(HASONEVALUE(dim_scenario[scenario]), MAX(scenario_evaluation[recovery_cost]))

Full Horizon Weighted Score =
IF(HASONEVALUE(dim_scenario[scenario]), MAX(scenario_evaluation[weighted_score]))

Full Horizon OTIF % =
IF(HASONEVALUE(dim_scenario[scenario]), MAX(scenario_evaluation[otif]))

Full Horizon Backlog Reduction % =
IF(HASONEVALUE(dim_scenario[scenario]), MAX(scenario_evaluation[backlog_reduction]))

Full Horizon Inventory Stability =
IF(HASONEVALUE(dim_scenario[scenario]), MAX(scenario_evaluation[inventory_stability]))

Full Horizon Risk Proxy =
IF(HASONEVALUE(dim_scenario[scenario]), MAX(scenario_evaluation[operational_risk]))

Full Horizon Rank =
IF(HASONEVALUE(dim_scenario[scenario]), MAX(scenario_evaluation[rank]))
